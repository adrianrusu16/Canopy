{
  "openapi": "3.0.3",
  "info": {
    "title": "Canopy gRPC API",
    "version": "0.1.0",
    "description": "gRPC backend for the PandaWave media ecosystem"
  },
  "servers": [
    {
      "url": "grpc://localhost:50051",
      "description": "gRPC server"
    }
  ],
  "paths": {
    "/canopy.Canopy/Browse": {
      "post": {
        "summary": "Browse media items",
        "operationId": "Browse",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BrowseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Search": {
      "post": {
        "summary": "Search media items",
        "operationId": "Search",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/GetMedia": {
      "post": {
        "summary": "Get media item by ID",
        "operationId": "GetMedia",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/GetMediaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/GetMediaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Play": {
      "post": {
        "summary": "Play media",
        "operationId": "Play",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/PlayRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/PlayResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Pause": {
      "post": {
        "summary": "Pause media",
        "operationId": "Pause",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/PauseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/PauseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Seek": {
      "post": {
        "summary": "Seek media",
        "operationId": "Seek",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/SeekRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/SeekResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/SetPlaybackSpeed": {
      "post": {
        "summary": "Set playback speed",
        "operationId": "SetPlaybackSpeed",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/SetPlaybackSpeedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/SetPlaybackSpeedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Stop": {
      "post": {
        "summary": "Stop media",
        "operationId": "Stop",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/StopRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/StopResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/GetSession": {
      "post": {
        "summary": "Get session",
        "operationId": "GetSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/GetSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/GetSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/UpdateSession": {
      "post": {
        "summary": "Update session",
        "operationId": "UpdateSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/EndSession": {
      "post": {
        "summary": "End session",
        "operationId": "EndSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/EndSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/EndSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/Health": {
      "post": {
        "summary": "Health check",
        "operationId": "Health",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/HealthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/ResolvePlayback": {
      "post": {
        "summary": "Resolve playback stream URL",
        "operationId": "ResolvePlayback",
        "description": "Selects an audio asset for a track and returns a time-limited presigned stream URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackSource"
                }
              }
            }
          }
        }
      }
    },
    "/canopy.Canopy/DiscoveryNext": {
      "post": {
        "summary": "Get next discovery track",
        "operationId": "DiscoveryNext",
        "description": "Returns the next shuffle-channel track after applying recent-play exclusion and diversity rules.",
        "requestBody": {
          "required": true,
          "content": {
            "application/protobuf": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryTrack"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrowseRequest": {
        "type": "object",
        "properties": {
          "parent_id": {
            "type": "string",
            "description": "Optional parent ID; empty => root"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum number of items to return"
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Offset for pagination"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional genre filter"
          }
        }
      },
      "BrowseResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaItem"
            }
          },
          "total_count": {
            "type": "integer",
            "format": "int32"
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaItem"
            }
          },
          "total_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetMediaRequest": {
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "description": "Media item ID"
          }
        }
      },
      "GetMediaResponse": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/MediaItem"
          }
        }
      },
      "MediaItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable engine-side identifier"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "artwork_uri": {
            "type": "string",
            "description": "content://\u2026 URI that the Android resolver knows"
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "description": "-1 if unknown (e.g., live stream)"
          },
          "bitrate_kbps": {
            "type": "integer",
            "format": "int32"
          },
          "mime_type": {
            "type": "string",
            "description": "e.g., \"audio/mp4\""
          },
          "is_explicit": {
            "type": "boolean"
          }
        }
      },
      "PlayRequest": {
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string"
          },
          "start_pos_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Optional start position in milliseconds; default 0"
          },
          "session_id": {
            "type": "string",
            "description": "Optional session ID; empty uses the default session"
          }
        }
      },
      "PlayResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error_msg": {
            "type": "string"
          },
          "session_id": {
            "type": "string",
            "description": "Session ID that was updated by the play request"
          }
        }
      },
      "PauseRequest": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Optional session ID; empty uses the default session"
          }
        }
      },
      "PauseResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "SeekRequest": {
        "type": "object",
        "properties": {
          "position_ms": {
            "type": "integer",
            "format": "int64"
          },
          "session_id": {
            "type": "string",
            "description": "Optional session ID; empty uses the default session"
          }
        }
      },
      "SeekResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "SetPlaybackSpeedRequest": {
        "type": "object",
        "properties": {
          "speed": {
            "type": "number",
            "format": "double",
            "description": "Playback speed (0.5 \u2026 2.0 typical)"
          },
          "session_id": {
            "type": "string",
            "description": "Optional session ID; empty uses the default session"
          }
        }
      },
      "SetPlaybackSpeedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "StopRequest": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Optional session ID; empty uses the default session"
          }
        }
      },
      "StopResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "GetSessionRequest": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          }
        }
      },
      "GetSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "current_media_id": {
            "type": "string"
          },
          "position_ms": {
            "type": "integer",
            "format": "int64"
          },
          "playback_speed": {
            "type": "number",
            "format": "double"
          },
          "is_playing": {
            "type": "boolean"
          }
        }
      },
      "UpdateSessionRequest": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "media_id": {
            "type": "string",
            "description": "New media to load (optional)"
          },
          "position_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Seek to this position on load (optional)"
          }
        }
      },
      "UpdateSessionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "EndSessionRequest": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          }
        }
      },
      "EndSessionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "HealthRequest": {
        "type": "object",
        "properties": {}
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "healthy": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "description": "Aggregate readiness status"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthDependency"
            }
          }
        }
      },
      "PlaybackRequest": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string",
            "description": "Track ID to resolve into a streamable playback source"
          },
          "session_id": {
            "type": "string",
            "description": "Optional anonymous session ID to synchronize after resolving playback; empty uses the default session"
          }
        }
      },
      "PlaybackSource": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string"
          },
          "stream_url": {
            "type": "string",
            "format": "uri",
            "description": "Signed, time-limited object-storage URL from RustFS or Supabase Storage"
          },
          "content_type": {
            "type": "string",
            "description": "MIME type served for the chosen asset"
          },
          "codec": {
            "type": "string",
            "description": "Codec short name for the chosen asset"
          },
          "duration_ms": {
            "type": "integer",
            "format": "uint64"
          },
          "expires_at_epoch_ms": {
            "type": "integer",
            "format": "uint64",
            "description": "Epoch millisecond timestamp when the stream URL expires"
          }
        }
      },
      "DiscoveryRequest": {
        "type": "object",
        "properties": {
          "recently_played": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Track IDs to exclude from the next discovery selection"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum items to consider or return; 0 uses the service default"
          }
        }
      },
      "DiscoveryTrack": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/MediaItem"
          }
        }
      },
      "HealthDependency": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-canopy-docs": {
    "persistenceStatus": "PostgreSQL provider ingest is transactional and idempotent by provider identity; discovery materialization uses one representative asset per track.",
    "sessionControlStatus": "Playback control RPCs mutate SessionRepository state; empty session_id maps to the default session.",
    "providerFixtureStartup": "Set CANOPY_PROVIDER_FIXTURE_PATH in PostgreSQL mode to ingest a local ProviderTrack fixture before serving gRPC.",
    "healthStatus": "Health responses include aggregate status plus dependency details; RustFS probing is opt-in via CANOPY_HEALTH_CHECK_RUSTFS.",
    "authModel": "Canopy is anonymous-by-default; session_id tracks playback state/history/preferences without requiring authentication. Token auth is optional future account-sync plumbing.",
    "playbackResolution": "ResolvePlayback accepts track_id plus optional session_id. It selects an audio asset, returns a RustFS or Supabase signed URL, and loads the track into the resolved session.",
    "supabaseMusicSource": "Set CANOPY_MUSIC_SOURCE=supabase with CANOPY_SUPABASE_URL, CANOPY_SUPABASE_KEY, CANOPY_SUPABASE_STORAGE_BUCKET, and CANOPY_SUPABASE_SIGNED_URL_TTL_SECS to fetch Supabase Storage signed URLs.",
    "supabaseCatalogSource": "SupabaseCatalogProvider reads normalized rows from CANOPY_SUPABASE_URL/rest/v1/CANOPY_SUPABASE_CATALOG_TABLE?select=* when CANOPY_SUPABASE_SYNC_ON_START=true in PostgreSQL mode, maps them into ProviderTrack, and ingests through CatalogIngest."
  }
}
