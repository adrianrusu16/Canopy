# Canopy — Local Development Environment Variables
#
# Copy this file to `.env` and adjust values as needed.
# docker-compose.yml references these variables with sensible defaults.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
CANOPY_POSTGRES_USER=canopy
CANOPY_POSTGRES_PASSWORD=canopy
CANOPY_POSTGRES_DB=canopy
CANOPY_POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (JadeCache)
# ---------------------------------------------------------------------------
CANOPY_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# RustFS (S3-compatible object storage)
# ---------------------------------------------------------------------------
CANOPY_RUSTFS_BUCKET=pandawave-media
CANOPY_RUSTFS_ACCESS_KEY=canopy
CANOPY_RUSTFS_SECRET_KEY=canopy-secret
CANOPY_RUSTFS_PORT=9000

# ---------------------------------------------------------------------------
# Adminer (DB management UI, dev-only)
# ---------------------------------------------------------------------------
CANOPY_ADMINER_PORT=8080

# ---------------------------------------------------------------------------
# Canopy Server (runtime overrides)
# ---------------------------------------------------------------------------
CANOPY_GRPC_ADDR=[::1]:50051
CANOPY_DATABASE_URL=postgres://canopy:canopy@localhost:5432/canopy

# PostgreSQL connection pool tuning
CANOPY_PG_MAX_CONNECTIONS=20
CANOPY_PG_ACQUIRE_TIMEOUT_SECS=5

CANOPY_RUSTFS_URL=http://localhost:9000
CANOPY_REDIS_URL=redis://localhost:6379

# Optional: ingest a provider fixture into PostgreSQL at startup when running with the `pg` feature.
CANOPY_PROVIDER_FIXTURE_PATH=fixtures/catalog.json
