# Canopy local development environment
#
# Copy this file to .env and replace development secrets before exposing any
# listener beyond loopback. RustFS is optional and inactive; its variables are
# retained only for the reserved Compose service, not the Canopy runtime.

# PostgreSQL container
CANOPY_POSTGRES_USER=canopy
CANOPY_POSTGRES_PASSWORD=canopy
CANOPY_POSTGRES_DB=canopy
CANOPY_POSTGRES_PORT=5432

# Canopy server and PostgreSQL pool
CANOPY_GRPC_ADDR=[::1]:50051
CANOPY_DATABASE_URL=postgres://canopy:canopy@localhost:5432/canopy
CANOPY_PG_MAX_CONNECTIONS=20
CANOPY_PG_ACQUIRE_TIMEOUT_SECS=5
CANOPY_AUTH_TOKEN_SECRET=replace-this-development-auth-secret

# Managed local media and protected streaming
CANOPY_MEDIA_ROOT=/srv/canopy/media
CANOPY_STREAM_PUBLIC_BASE_URL=http://127.0.0.1:8080
CANOPY_STREAM_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CANOPY_STREAM_TOKEN_TTL_SECS=600
CANOPY_STREAM_AUTH_ADDR=127.0.0.1:8081
CANOPY_MAX_AUDIO_BYTES=2147483648
CANOPY_MAX_ARTWORK_BYTES=20971520

# Optional deterministic provider fixture
# CANOPY_PROVIDER_FIXTURE_PATH=fixtures/catalog.json

# Redis is provisioned for the future JadeCache adapter but is not connected
# by the current server.
CANOPY_REDIS_PORT=6379
CANOPY_REDIS_URL=redis://localhost:6379

# Adminer is an opt-in development profile.
CANOPY_ADMINER_PORT=8080

# Inactive, future-reserved RustFS Compose service. Active playback never uses
# these settings and readiness does not depend on RustFS.
CANOPY_RUSTFS_BUCKET=pandawave-media
CANOPY_RUSTFS_ACCESS_KEY=canopy
CANOPY_RUSTFS_SECRET_KEY=replace-this-inactive-development-secret
CANOPY_RUSTFS_PORT=9000
